Cell[CellGroupData[{

Cell["\<\
Correlation between dipole moment, volume, and polar parameter\
\>", "Subsection",
 CellChangeTimes->{{3.794503127387228*^9, 3.794503141632533*^9}, {
  3.7945072306449213`*^9, 3.794507232525147*^9}}],

Cell[TextData[{
 "Zeng ",
 StyleBox["et al.",
  FontSlant->"Italic"],
 " note an empirical relationship observed by Beerbower and Dicky (1969) \
between the dipole moment, molar volume, and the polar parameter, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "p"], TraditionalForm]]],
 ".  Again we can extract the dipole moment from the ",
 ButtonBox["Chemical",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/entity/Chemical.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/entity/Chemical.html"],
 " entity, using the molar volume provided in the dataset as the \"Volume\" \
column:"
}], "Text",
 CellChangeTimes->{{3.794501172937787*^9, 3.794501197488462*^9}, {
  3.7945032750746717`*^9, 3.794503282874784*^9}, {3.79450723609266*^9, 
  3.7945072812076273`*^9}, {3.794508936343801*^9, 3.7945089879906073`*^9}, {
  3.794562732182942*^9, 3.794562778946686*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"DeleteMissing", "[", 
      RowBox[{"#", ",", "1", ",", "Infinity"}], "]"}], "&"}], "@", 
    RowBox[{"Normal", "@", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<Solvent\>\"", "]"}], "[", 
            "\"\<DipoleMoment\>\"", "]"}], "/", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"#", "[", "\"\<Volume\>\"", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"#", "[", "\"\<\[Delta]p\>\"", "]"}], "^", "2"}]}], "}"}], 
        "&"}], ",", 
       RowBox[{"ResourceData", "[", 
