Notebook[{
Cell["Hansen Solubility Parameters", "Title",
 CellTags->{"Name", "TemplateCell"}],

Cell["Hansen solubility parameters for 211 common solvents", "Text",
 CellTags->{"Description", "TemplateCell"}],

Cell[CellGroupData[{

Cell[TextData[{
 "Details",
 Cell[BoxData[
  TemplateBox[{"Details", 
    Cell[
     BoxData[
      FrameBox[
       Cell[
