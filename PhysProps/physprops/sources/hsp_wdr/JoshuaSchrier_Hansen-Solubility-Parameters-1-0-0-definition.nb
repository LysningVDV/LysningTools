Cell[TextData[{
 "Similarly, Beilstein numbers are contained in the ",
 ButtonBox["Chemical",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/entity/Chemical.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/entity/Chemical.html"],
 " entity entries.  Not all of the Wolfram Chemical Entities have Beilstein \
number data, so it is useful to define the ",
 ButtonBox["FailureAction",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FailureAction.html"], None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/FailureAction.html"],
 " for the ",
 ButtonBox["Query",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Query.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Query.html"],
 " to ignore these:"
}], "Text",
 CellChangeTimes->{{3.696377005707614*^9, 3.69637702247129*^9}, {
   3.696377225845625*^9, 3.696377236186659*^9}, 3.696377278504891*^9, {
   3.696377319054945*^9, 3.6963773247475147`*^9}, 3.6963774601870575`*^9, {
   3.696377490692107*^9, 3.696377510279066*^9}, {3.794562268514485*^9, 
   3.794562297917131*^9}, {3.794578055932499*^9, 3.794578143127617*^9}}],

Cell[CellGroupData[{

