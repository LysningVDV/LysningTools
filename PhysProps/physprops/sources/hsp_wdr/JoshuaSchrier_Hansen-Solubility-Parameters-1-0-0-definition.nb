        "\"\<BeilsteinNumber\>\"", "]"}], "\[Equal]", 
       "\"\<Beilstein385737\>\""}], "&"}], "]"}], ",", 
    RowBox[{"FailureAction", "\[Rule]", "None"}]}], "]"}], "@", 
