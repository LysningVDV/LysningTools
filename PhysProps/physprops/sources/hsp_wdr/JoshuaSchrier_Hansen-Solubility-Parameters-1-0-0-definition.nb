Cell[CellGroupData[{

Cell["Finding compatible solvents", "Subsection",
 CellChangeTimes->{{3.794505714486802*^9, 3.794505721582062*^9}, 
   3.7945629150459948`*^9}],

Cell["\<\
Hansen parameters quantify \[OpenCurlyDoubleQuote]like dissolves like\
\[CloseCurlyDoubleQuote] solvation rules by the distance between a solutes \
Hansen triple (usually empirically determined), and the solvent properties.  \
There is a modified Euclidean distance between the solute and solvent triples \
(the dispersive feature, \[Delta]d, has an additional factor of 4).  For \
example, a particular formulation of Nylon-66 has the Hanson triple:\
\>", "Text",
 CellChangeTimes->{{3.794507309246461*^9, 3.7945073847075872`*^9}, {
  3.794562819627389*^9, 3.794562871588489*^9}, {3.79456292157344*^9, 
  3.7945629803821087`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"nylon", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<\[Delta]d\>\"", "->", "18.62"}], ",", 
     RowBox[{"\"\<\[Delta]p\>\"", "->", "5.11"}], ",", 
     RowBox[{"\"\<\[Delta]h\>\"", "->", "12.28"}]}], "|>"}]}], ";"}]], "Input",\

 CellLabel->"In[38]:="],

Cell["Construct a query to compute the distance:", "Text",
 CellChangeTimes->{{3.7945073869943943`*^9, 3.794507413897552*^9}, {
  3.794508452801326*^9, 3.794508462846613*^9}, {3.794509043483672*^9, 
  3.794509044371134*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"soluteQuery", "[", "solute_Association", "]"}], ":=", 
  RowBox[{"Query", "[", 
   RowBox[{"All", ",", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Solvent\>\"", "->", "#Solvent"}], ",", 
       RowBox[{"\"\<Distance\>\"", "\[Rule]", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"4", "*", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"QuantityMagnitude", "@", 
               RowBox[{"#", "[", "\"\<\[Delta]d\>\"", "]"}]}], "-", 
              RowBox[{"solute", "[", "\"\<\[Delta]d\>\"", "]"}]}], ")"}], 
            "2"]}], "+", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"QuantityMagnitude", "@", 
              RowBox[{"#", "[", "\"\<\[Delta]p\>\"", "]"}]}], "-", 
             RowBox[{"solute", "[", "\"\<\[Delta]p\>\"", "]"}]}], ")"}], "2"],
           "+", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"QuantityMagnitude", "@", 
              RowBox[{"#", "[", "\"\<\[Delta]h\>\"", "]"}]}], "-", 
             RowBox[{"solute", "[", "\"\<\[Delta]h\>\"", "]"}]}], ")"}], 
           "2"]}], "]"}]}]}], "|>"}], "&"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7945058356676807`*^9, 3.7945058397818193`*^9}, {
  3.794505973937468*^9, 3.794506056847992*^9}, {3.794506090223814*^9, 
  3.794506129038966*^9}, {3.79450623581607*^9, 3.794506245852295*^9}, {
  3.794506404823784*^9, 3.794506477324048*^9}, {3.7945068084901447`*^9, 
  3.794506813365036*^9}, {3.794508493992466*^9, 3.7945085109497833`*^9}},
 CellLabel->"In[39]:="],

Cell["\<\
Apply this query to the dataset, sorting by Distance; the solvents with the \
smallest distance are predicted to be better solvents:\
\>", "Text",
 CellChangeTimes->{{3.794507420625072*^9, 3.794507466296874*^9}, {
  3.7945076397050943`*^9, 3.794507648589061*^9}, {3.7945078435509443`*^9, 
  3.7945078531543837`*^9}, {3.794507914374712*^9, 3.79450796658823*^9}, {
  3.7945084731827517`*^9, 3.794508474222919*^9}, {3.794509052636676*^9, 
  3.794509053331751*^9}}],

